# Every variable the code reads, grouped by process. All are optional;
# defaults are shown. The API loads this file from the repo root (.env).

# ── API server (api/) ─────────────────────────────────────────────────────

# Database. Default: SQLite at var/mtg_deck_builder.db. Postgres (+ pgvector) optional.
DATABASE_URL=
MTG_USE_PGVECTOR=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth: when set, generate/refine/analyze/chat/evaluate/optimizer/prose and
# save/history require X-API-Key. Comma-separated keys allow rotation. Unset =
# open dev mode. Saved decks store a hash of the key, never the key.
MTG_API_KEY=
# Set to 1 only when the API is reachable solely through a proxy that sets
# X-Forwarded-For (e.g. the web app's /api/backend proxy); otherwise every
# client shares the proxy's rate-limit bucket.
MTG_TRUST_FORWARDED=0

# LLM providers. Unset = deterministic fallbacks (no LLM spend).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_FAST_MODEL=
ANTHROPIC_ANALYSIS_MODEL=
MTG_BUILDER_MODEL=claude-opus-4-7
MTG_CRITIC_MODEL=gpt-5.5
MTG_COACH_MODEL=claude-haiku-4-5-20251001
MTG_COACH_DISABLE=false
# Request timeouts in seconds (interactive / background jobs) and retries.
MTG_LLM_TIMEOUT_SECONDS=30
MTG_LLM_BACKGROUND_TIMEOUT_SECONDS=120
MTG_LLM_MAX_RETRIES=1
# Critic loop cost gates.
MTG_CRITIC_MAX_TOKENS_PER_CALL=4096
MTG_CRITIC_MAX_USD_PER_JOB=1.50

# Generation
# Route constructed generation through the simulator optimizer (slower; keeps
# the generated list unless the optimizer finds a legal, on-budget improvement).
MTG_USE_OPTIMIZER_DEFAULT=false
MTG_GENERATE_CACHE_TTL=600
# Build sideboard/bracket pools in the background at startup.
MTG_WARM_CACHES=1
# Card data older than this (newest card release date) is reported as stale.
MTG_DATA_STALE_DAYS=60

# Background jobs: in-process threads by default; celery needs REDIS_URL.
MTG_WORKER_BACKEND=thread
MTG_WORKER_THREADS=
REDIS_URL=redis://localhost:6379/0
MTG_CELERY_RESULT_BACKEND=

# Monetization: TCGplayer affiliate deep-link prefix from Impact (impact.com),
# e.g. https://tcgplayer.pxf.io/c/123456/789012/21018. When set, every
# TCGplayer purchase link the API serves is affiliate-wrapped.
TCGPLAYER_AFFILIATE_URL=

# Card ingestion
SCRYFALL_BULK_DATA_URL=https://api.scryfall.com/bulk-data
SCRYFALL_USER_AGENT=mtg-deck-builder/0.1

# ── Web server (web/) ─────────────────────────────────────────────────────

# Where the Next.js server-side proxy (/api/backend) forwards API calls.
API_BASE=http://127.0.0.1:8000
# The proxy adds this as X-API-Key. Server-side only: never NEXT_PUBLIC_.
# MTG_API_KEY=  (same variable as above when both run from one .env)
# Mirror of TCGPLAYER_AFFILIATE_URL for client-built shopping + Mass Entry links.
NEXT_PUBLIC_TCGPLAYER_AFFILIATE_URL=
# Google AdSense publisher ID (ca-pub-...). Unset = no ad script, no ad slots,
# /ads.txt returns 404. Set in Vercel, then redeploy (inlined at build time).
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional manual ad unit ID for the page footer. Without it, only Auto ads
# (configured in the AdSense dashboard) place ads.
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
# Contact address shown on /privacy (AdSense review expects one).
NEXT_PUBLIC_CONTACT_EMAIL=
