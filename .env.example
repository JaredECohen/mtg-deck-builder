# App
APP_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mtg_deck_builder
REDIS_URL=redis://localhost:6379/0

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-5
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Card / deck data ingestion
SCRYFALL_BULK_DATA_URL=https://api.scryfall.com/bulk-data
SCRYFALL_USER_AGENT=mtg-deck-builder/0.1

# Optional third-party deck/metagame sources
# Fill only if you have licensed/approved access to them.
MTG_DECKS_API_KEY=
MELEE_API_KEY=

# Storage
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Observability
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
